      "css": ".ds-search{position:relative;width:288px;background:var(--color-ink,#1a1714);padding:12px;} .ds-search svg{position:absolute;left:24px;top:50%;transform:translateY(-50%);color:var(--color-muted,#a39a8e);pointer-events:none;} .ds-input{font-family:'Noto Sans TC','PingFang TC','Microsoft JhengHei',sans-serif;width:100%;font-size:.875rem;line-height:1.25rem;background:var(--color-ink-raised,#221e1a);color:var(--color-paper,#efe8dc);border:1px solid var(--color-rule,#3a332c);border-radius:4px;padding:8px 36px;} .ds-input::placeholder{color:var(--color-muted,#a39a8e);} .ds-input:focus{outline:none;border-color:var(--color-paper-dim,#c9c0b3);} .ds-kbd{position:absolute;right:22px;top:50%;transform:translateY(-50%);font-size:.75rem;color:var(--color-muted,#a39a8e);border:1px solid var(--color-rule,#3a332c);border-radius:4px;padding:0 6px;}"
